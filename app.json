{
  "expo": {
    "name": "ICSA",
    "slug": "icsa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "icsa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "us.icsa.app",
      "appleTeamId": "69B3AATWN8",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D47A1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "us.icsa.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.834637605414-p01k9vro3eiqilr45c51cuidu0tueefc"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "To unlock ICSA quickly and keep your account safe."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D47A1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
